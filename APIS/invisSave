
Concurrent(
    Set(vShowSpinner, true),
    Set(vShowCtrConfirmation, false),
    Patch(colAudit, Defaults(colAudit),
        {
            comment: If(vAction = "Reassigned", $"{vSelectedRequest.DeptApproverName} ({vSelectedRequest.DeptApproverEmail}) > {cbx_reassign.Selected.GPUserName} ({cbx_reassign.Selected.GPUserEmail})", txt_negativeComment.Text),
            desc: $"{vAction} | { Coalesce(vSelectedRequest.Status, "Draft") }",
            ts: Now(),
            userEmail: vCurrentUser.Email,
            userName: vCurrentUser.FullName
        }
    )
);

With(
    {_isNew: vIsNew || IsBlank(vSelectedRequest)},
    IfError(
        // ---- 1. Single SharePoint Patch (create when new, update otherwise) ----
        Set(vLastPatched,
            Patch(APIS_SPO_List_Requests,
                If(_isNew,
                    Defaults(APIS_SPO_List_Requests),
                    LookUp(APIS_SPO_List_Requests, ID = vSelectedRequest.ID)
                ),
                {
                    AttachmentGUID: vSelectedRequestGUID,
                    'Audit Trail': JSON(colAudit, JSONFormat.Compact),
                    'Bank Code': Coalesce(cbx_vendorName.Selected.BankCode, vSelectedRequest.BankCode),

                    // Caller contract: blank vDeptApprover* keeps the stored values,
                    // vClearDeptApprover wipes them; blank vNextApprover* routes by
                    // stage name.
                    'Current Approver': Coalesce(vNextApproverName, vNextStage),
                    'Current Approver Email': Coalesce(vNextApproverEmail, vNextStage),
                    Department: cbx_department.Selected.Value,
                    'Dept Approver Email': If(vClearDeptApprover, Blank(), Coalesce(vDeptApproverEmail, vSelectedRequest.DeptApproverEmail)),
                    'Dept Approver Name': If(vClearDeptApprover, Blank(), Coalesce(vDeptApproverName, vSelectedRequest.DeptApproverName)),

                    'Due Date': dp_dueDate.SelectedDate,
                    'Invoice Amount': num_invoiceAmount.Value,
                    'Invoice Date': dp_invoiceDate.SelectedDate,
                    'Invoice Number': txt_invoiceNumber.Text,
                    'Maintenance or Holdback': tog_maintainanceHoldback.Checked,
                    Notes: JSON(colNotes, JSONFormat.Compact),
                    'Percentage to be Applied': Coalesce(num_percentTobeApplied.Value, vSelectedRequest.PercentagetobeApplied),
                    'PO Description': Coalesce(txt_poDescription.Text, vSelectedRequest.PODescription),
                    'PO Exemption': tog_poExemption.Checked,
                    'PO Exemption Reason': cbx_poExemptionReason.Selected,
                    'PO Number': Coalesce(txt_poNumber.Text, vSelectedRequest.PONumber),
                    'PO Type': Coalesce(txt_poType.Text, vSelectedRequest.POType),
                    POInfoJSON: If(tog_poExemption.Checked, Blank(), If(!IsBlank(vSelectedPODetail), JSON(vSelectedPODetail, JSONFormat.Compact))),
                    POLineInfoJSON: If(tog_poExemption.Checked, If(!IsEmpty(colExemptions), JSON(colExemptions, JSONFormat.Compact)) , If(!IsEmpty(colNonExemptions), JSON(colNonExemptions, JSONFormat.Compact ) ) ),
                    'Preparer Email': Coalesce(cbx_preparer.Selected.Mail, vSelectedRequest.PreparerEmail),
                    'Preparer Name': Coalesce(cbx_preparer.Selected.DisplayName, vSelectedRequest.PreparerName),
                    'Remaining Funds Available': Coalesce(num_remainingFundsAvailable.Value, vSelectedRequest.RemainingFundsAvailable),
                    Status: {Value: vNextStage},

                    // Routing actions fire the flow; a quick save writes Blank()
                    // so the flow's not-empty trigger condition skips it. New
                    // records stay blank here and get stamped in step 2, after
                    // RequestNum exists.
                    TriggerAction:
                        If(!_isNew && vAction in ["Requested approval", "Approved", "Rejected", "Reassigned"],
                            vAction
                        ),

                    'Total PO Value': Coalesce(num_totalPOValue.Value, vSelectedRequest.TotalPOValue),
                    'Vendor Code': Coalesce(cbx_vendorName.Selected.VendorCode, vSelectedRequest.VendorCode),
                    'Vendor Name': Coalesce(cbx_vendorName.Selected.VendorName, vSelectedRequest.VendorName)
                }
            )
        );

        // ---- 2. New records: stamp the request number and fire the flow ----
        If(_isNew,
            Set(vLastPatched,
                Patch(APIS_SPO_List_Requests, vLastPatched,
                    {
                        RequestNum: "R-" & Text(vLastPatched.ID, "00000000"),
                        // Submitted-on-create keeps the real action; a plain
                        // first save fires as "Created" so the flow can branch.
                        TriggerAction:
                            If(vAction in ["Requested approval", "Approved", "Rejected", "Reassigned"],
                                vAction,
                                "Created"
                            )
                    }
                )
            )
        );

        // ---- 3. Single collection Patch, mapped from the server's returned record ----
        Set(vSelectedRequest,
            Patch(colAllRequests,
                If(_isNew,
                    Defaults(colAllRequests),
                    LookUp(colAllRequests, ID = vSelectedRequest.ID)
                ),
                {
                    AttachmentGUID: vLastPatched.AttachmentGUID,
                    AuditTrail: vLastPatched.'Audit Trail',
                    BankCode: vLastPatched.'Bank Code',

                    // Stamp creator info only on create; keep the original on edits.
                    Created:        If(_isNew, Now(),                 vSelectedRequest.Created),
                    CreatedBy:      If(_isNew, vCurrentUser.FullName, vSelectedRequest.CreatedBy),
                    CreatedByEmail: If(_isNew, vCurrentUser.Email,    vSelectedRequest.CreatedByEmail),

                    CurrentApprover: vLastPatched.'Current Approver',
                    CurrentApproverEmail: vLastPatched.'Current Approver Email',
                    Department: vLastPatched.Department,
                    DeptApproverEmail: vLastPatched.'Dept Approver Email',
                    DeptApproverName: vLastPatched.'Dept Approver Name',
                    DueDate: vLastPatched.'Due Date',
                    ID: vLastPatched.ID,
                    InvoiceAmount: vLastPatched.'Invoice Amount',
                    InvoiceDate: vLastPatched.'Invoice Date',
                    InvoiceNumber: vLastPatched.'Invoice Number',
                    MaintenanceorHoldback: vLastPatched.'Maintenance or Holdback',
                    Notes: vLastPatched.Notes,
                    PercentagetobeApplied: vLastPatched.'Percentage to be Applied',
                    PODescription: vLastPatched.'PO Description',
                    POExemption: vLastPatched.'PO Exemption',
                    POExemptionReason: vLastPatched.'PO Exemption Reason'.Value,
                    POInfoJSON: vLastPatched.POInfoJSON,
                    POLineInfoJSON: vLastPatched.POLineInfoJSON,
                    PONumber: vLastPatched.'PO Number',
                    POType: vLastPatched.'PO Type',
                    PreparerEmail: vLastPatched.'Preparer Email',
                    PreparerName: vLastPatched.'Preparer Name',
                    RemainingFundsAvailable: vLastPatched.'Remaining Funds Available',
                    RequestNum: vLastPatched.RequestNum,
                    Status: vNextStage,
                    TotalPOValue: vLastPatched.'Total PO Value',
                    VendorCode: vLastPatched.'Vendor Code',
                    VendorName: vLastPatched.'Vendor Name'
                }
            )
        ),

        // ---- On error: report and stay on the screen ----
        Concurrent(
            Set(vShowSpinner, false),
            Notify($"Save failed: {FirstError.Message}", NotificationType.Error)
        ),

        // ---- On success ----
        Concurrent(
            Set(vIsNew, false),
            Set(vShowSpinner, false),
            Set(vNextApproverName, Blank()),
            Set(vNextApproverEmail, Blank()),
            Set(vDeptApproverName, Blank()),
            Set(vDeptApproverEmail, Blank()),
            Set(vClearDeptApprover, false),
            Reset(cbx_reassign),
            Reset(txt_negativeComment),
            Notify("Saved successfully", NotificationType.Success, 2000)
        );
        If(vStayAfterSave,
            Set(vStayAfterSave, false),
            Navigate(scr_list, ScreenTransition.Fade)
        )
    )
)


