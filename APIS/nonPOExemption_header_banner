nfHtmlReset & $"
<table style='table-layout: fixed; width: 100%; border-collapse: collapse; border-spacing: 0; margin: 0; padding: 0; font-family: Segoe UI, sans-serif; border: 1px solid #e2e8f0;'>
  <colgroup>
    <col style='width: 10%'>
    <col style='width: 11%'>
    <col style='width: 13%'>
    <col style='width: 10%'>
    <col style='width: 10%'>
    <col style='width: 10%'>
    <col style='width: 36%'>
  </colgroup>
  <!-- ROW 1: Vendor + PO usage summary -->
  <tr style='background: #ffffff; border-bottom: 1px solid #e2e8f0; height: 60px;'>
    <td colspan='2' style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Vendor Name</div><div style='font-size: 13px; color: #0f172a; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;' title='{cbx_vendorName.Selected.VendorName}'>{cbx_vendorName.Selected.VendorName}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Vendor Code</div><div style='font-size: 13px; color: #0f172a; font-weight: 600;'>{cbx_vendorName.Selected.VendorCode}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>POs Found</div><div style='font-size: 13px; font-weight: 700; color: {If(CountRows(colPOs) = 0, "#dc2626", "#0f172a")};'>{If(CountRows(colPOs) = 0, "No PO found", Text(CountRows(colPOs)))}</div></td>
    <td colspan='2' style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Amount Used</div><div style='font-size: 13px; color: #1e40af; font-weight: 700;'>{Coalesce(Text(Sum(colNonExemptions, ItemDistributionAmount), "[$-en-US]$#,##0.00"), "$0.00")} / {Coalesce(Text(vCurrentInvoiceAmt, "[$-en-US]$#,##0.00"), "$0.00")}</div></td>
    <td colspan='2' style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Percent Used</div><div style='font-size: 13px; color: #1e40af; font-weight: 700;'>{
        If(vCurrentInvoiceAmt <= 0,
            Text(1 * ((Sum(colNonExemptions, ItemDistributionAmount) - vCurrentInvoiceAmt) / 1), "##0.00%"),
            Text(100 * (Sum(colNonExemptions, ItemDistributionAmount) / vCurrentInvoiceAmt), "##0.00%")
        )
    }</div></td>
  </tr>
  <!-- ROW 2: PO detail -->
  <tr style='background: #f8fafc; border-bottom: 1px solid #e2e8f0; height: 60px;'>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>PO #</div><div style='font-size: 13px; color: #0f172a; font-weight: 700;'>{vSelectedPODetail.poNumber}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>PO Total</div><div style='font-size: 13px; color: #1e40af; font-weight: 700;'>{Coalesce(Text(vSelectedPODetail.poItemAmount, "[$-en-US]$#,###.00"), "$0.00")}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #d97706; font-weight: 600; margin-bottom: 2px;'>PO Outstanding $</div><div style='font-size: 13px; color: #d97706; font-weight: 700;'>{Coalesce(Text(vSelectedPODetail.amountOutstanding, "[$-en-US]$#,###.00"), "$0.00")}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Dept Code</div><div style='font-size: 13px; color: #0f172a; font-weight: 600;'>{vSelectedPODetail.departmentCode}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Vendor Code</div><div style='font-size: 13px; color: #0f172a; font-weight: 600;'>{vSelectedPODetail.vendorCode}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Type</div><div style='font-size: 13px; color: #2563eb; font-weight: 600;'>{vSelectedPODetail.poType}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>PO Description</div><div style='font-size: 12px; color: #0f172a; font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; white-space: normal; word-break: break-word;' title='{vSelectedPODetail.description}'>{vSelectedPODetail.description}</div></td>
  </tr>
</table>"
