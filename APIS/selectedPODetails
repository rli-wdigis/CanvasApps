nfHtmlReset & $"
<div style='padding: 6px 16px 6px 6px; font-family: Segoe UI, sans-serif; background: #ffffff; border-bottom: 1px solid #e2e8f0;'>
  <div style='display: flex; align-items: center; gap: 8px;'>
    <div style='background: {nfAccentColorText}14; border-left: 3px solid {nfAccentColorText}; padding: 3px 10px; border-radius: 0 6px 6px 0; white-space: nowrap;'>
      <h2 style='margin: 0; font-size: 14px; font-weight: 600; color: {nfPrimaryColorText}; text-transform: uppercase;'>PO Details</h2>
    </div>
    <div style='flex: 1; height: 2px; background: linear-gradient(to right, {nfAccentColorText}, {nfAccentColorText}00); border-radius: 2px;'></div>
  </div>
</div>" &
If(IsBlank(vSelectedPODetail),
    $"
<div style='width: 100%; border: 1px dashed #cbd5e1; background: #f8fafc; font-family: Segoe UI, sans-serif; font-size: 12px; color: #64748b; font-weight: 600; text-align: center; padding: 20px 0;'>No PO selected</div>",
    $"
<table style='table-layout: fixed; width: 100%; border-collapse: collapse; border-spacing: 0; margin: 0; padding: 0; font-family: Segoe UI, sans-serif; border: 1px solid #e2e8f0;'>
  <colgroup>
    <col style='width: 18%'>
    <col style='width: 22%'>
    <col style='width: 22%'>
    <col style='width: 18%'>
    <col style='width: 20%'>
  </colgroup>
  <!-- Selected PO detail -->
  <tr style='background: #f8fafc; border-bottom: 1px solid #e2e8f0; height: 60px;'>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>PO #</div><div style='font-size: 13px; color: #0f172a; font-weight: 700;'>{vSelectedPODetail.poNumber}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>PO Total</div><div style='font-size: 13px; color: #1e40af; font-weight: 700;'>{Coalesce(Text(vSelectedPODetail.poItemAmount, "[$-en-US]$#,###.00"), "$0.00")}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #d97706; font-weight: 600; margin-bottom: 2px;'>PO Outstanding $</div><div style='font-size: 13px; color: #d97706; font-weight: 700;'>{Coalesce(Text(vSelectedPODetail.amountOutstanding, "[$-en-US]$#,###.00"), "$0.00")}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>Type</div><div style='font-size: 13px; color: #2563eb; font-weight: 600;'>{vSelectedPODetail.poType}</div></td>
    <td style='padding: 6px; vertical-align: middle; text-align: center;'><div style='font-size: 10px; color: #64748b; font-weight: 600; margin-bottom: 2px;'>% To Be Applied</div><div style='font-size: 13px; color: {If(Coalesce(vSelectedPODetail.poItemAmount, 0) = 0, "#dc2626", "#1e40af")}; font-weight: 700;'>{
        If(Coalesce(vSelectedPODetail.poItemAmount, 0) = 0,
            "N/A",
            Text(Round(num_invoiceAmount.Value / vSelectedPODetail.poItemAmount * 100, 2), "##0.00") & "%"
        )
    }</div></td>
  </tr>
</table>"
)
