With(
    {
        _isGroupStart:
            ThisItem.ItemDistributionLineNumber =
            First(
                SortByColumns(
                    Filter(colNonExemptions, POItemNumber = ThisItem.POItemNumber),
                    "ItemDistributionLineNumber",
                    SortOrder.Ascending
                )
            ).ItemDistributionLineNumber,
        _lineCount:
            CountRows(Filter(colNonExemptions, POItemNumber = ThisItem.POItemNumber))
    },
   nfHtmlReset & $"
<table style='table-layout: fixed; width: 100%; border-collapse: collapse; margin: 0; padding: 0; font-family: Segoe UI, sans-serif; background: {If(ThisItem.IsSelected, "#f1f5f9", "#ffffff")}; border-bottom: 1px solid #e2e8f0;'>
<colgroup>
    <!-- R1: Line #         --><col style='width: 8%'>
    <!-- R2: GL Code        --><col style='width: 10%'>
    <!-- R3: GL Name        --><col style='width: 24%'>
    <!-- R4: CC1            --><col style='width: 14%'>
    <!-- R5: CC2            --><col style='width: 14%'>
    <!-- R6: Distr. Amount  --><col style='width: 15%'>
    <!-- R7: Distr. Percent --><col style='width: 15%'>
</colgroup>
{
    If(_isGroupStart,
        $"<tr>
  <td colspan='7' style='height: 40px; padding: 0 12px; vertical-align: middle; background: #eef2f7; border-left: 4px solid {nfPrimaryColorText}; border-top: 1px solid #cbd5e1; font-size: 11.5px; color: #0f172a; font-weight: 700; letter-spacing: 0.2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;'>
    PO ITEM {ThisItem.POItemNumber}
    <span style='font-weight: 500; color: #334155;'>&nbsp;&#183;&nbsp; {ThisItem.POItemName}
      &nbsp;&#183;&nbsp; {Text(ThisItem.POItemAmount, "[$-en-US],$#,##0.00")}
      &nbsp;&#183;&nbsp; {_lineCount} distribution line{If(_lineCount > 1, "s", "")}</span>
  </td>
</tr>",
        ""
    )
}
<tr style='cursor: pointer;'>
  <!-- R1: Line # -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: {nfPrimaryColorText}; font-weight: 600; position: relative;'>
    {ThisItem.ItemDistributionLineNumber}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R2: GL Code -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #0f172a; font-weight: 500; position: relative;'>
    {ThisItem.GL}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R3: GL Name -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #0f172a; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; position: relative;' title='{ThisItem.GLName}'>
    {ThisItem.GLName}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R4: CC1 -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; position: relative;' title='{ThisItem.CC1}'>
    {ThisItem.CC1}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R5: CC2 -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; position: relative;' title='{ThisItem.CC2}'>
    {ThisItem.CC2}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R6: Distr. Amount -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #0f172a; font-weight: 600; position: relative;'>
    {Text(ThisItem.ItemDistributionAmount, "[$-en-US],$#,##0.00")}
    <div style='position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #e2e8f0;'></div>
  </td>

  <!-- R7: Distr. Percent (no divider on last column) -->
  <td style='padding: 10px 6px; vertical-align: middle; text-align: center; font-size: 11px; color: #0f172a; font-weight: 600;'>
    {Text(100 * ThisItem.ItemDistributionPercent, "0.00%")}
  </td>

</tr>
</table>
"
)
